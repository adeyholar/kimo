{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kimo Spectator",
  "version": "0.1.0",
  "identifier": "dev.kimo.spectator",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Kimo · spectator",
        "width": 1620,
        "height": 980,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
