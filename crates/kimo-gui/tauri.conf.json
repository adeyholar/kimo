{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kimo Spectator",
  "version": "0.1.0",
  "identifier": "dev.kimo.spectator",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "Kimo \u00b7 spectator",
        "width": 1376,
        "height": 768,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "label": "main",
        "backgroundColor": "#0a0a0b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false
  }
}